# DeepSeek（推荐）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding（可选，留空则用本地 hash embedder）
EMBED_PROVIDER=hash
EMBED_MODEL=text-embedding-3-small

# 运行参数
AGENT_CONFIDENCE_THRESHOLD=0.75
AGENT_EXPLORE_BUDGET=3
DB_PATH=capital.db
DIMS_PATH=dimensions.json
POLICY_PATH=local_policy.npz
